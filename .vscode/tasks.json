{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Packages: Watch",
      "type": "shell",
      "command": "pnpm packages:watch",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    {
      "label": "Client: Start",
      "type": "shell",
      "command": "pnpm client:start",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },

    {
      "label": "Server: Start",
      "type": "shell",
      "command": "pnpm server:start:dev",
      "problemMatcher": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    
    {
      "label": "Development: All",
      "dependsOn": [
        "Packages: Watch",
        "Client: Start",
        "Server: Start"
      ],
      "dependsOrder": "parallel",
      "detail": "Run packages watcher, Angular dev server and Nest dev server in dedicated terminals"
    }
  ]
}